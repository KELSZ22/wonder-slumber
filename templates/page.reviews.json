    "94972321-9b6d-4bdc-9965-835bec10c679": {
      "type": "rich-text",
      "blocks": {
        "template--16629528068339__94972321-9b6d-4bdc-9965-835bec10c679-1665327871d606a5fd-1": {
          "type": "text",
          "settings": {
            "text": "<p>Effective po siya sabi ng mother ko, nakakatulog na po siya ng mas mabilis :) <strong>[Claire, Instagram]</strong></p>"
          }
        }
      },
      "block_order": [
