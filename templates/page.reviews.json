      "type": "rich-text",
      "blocks": {
        "template--16629528068339__9cc52084-c1e1-4a2d-b4f3-1f18f4ce8ef1-1665327871d606a5fd-1": {
          "type": "text",
          "settings": {
            "text": "<p>Can’t thank you enough! My hunt for the perfect pillow is done! These are excellent since I’ve decided to invest in getting better sleep. <strong>[Mac, Instagram]</strong></p>"
          }
        }
      },
      "block_order": [
