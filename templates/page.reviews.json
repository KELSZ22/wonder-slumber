      "type": "rich-text",
      "blocks": {
        "template--16629528068339__a4b86e6f-e04a-454b-a6f4-4784c7e30e46-1665327871d606a5fd-1": {
          "type": "text",
          "settings": {
            "text": "<p>We love our blanket! I bought several to give as gifts and they all loved them too! I will be ordering more this christmas! <strong>[Beth, Instagram]</strong></p>"
          }
        }
      },
      "block_order": [
        "template--16629528068339__a4b86e6f-e04a-454b-a6f4-4784c7e30e46-1665327871d606a5fd-1"
