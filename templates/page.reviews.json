            "heading_size": "h1"
          }
        },
        "template--16629528068339__0a49df22-1019-4b88-be3b-a2732b215e07-1665327871d606a5fd-1": {
          "type": "text",
          "settings": {
            "text": "<p>It’s better than I expected po. It’s very comfortable and it isn’t as restricting as it looks. I love how adjustable it is. The mask helped me out a lot po! I work nights po kasi, kaya it’s a must have for me. I appreciate the free earplugs din po. Again, thank you for making this! I’ll be getting the weighted blanket next po :)  <strong>[Ea, Facebook]</strong></p>"
          }
        }
      },
      "block_order": [
        "template--16629528068339__0a49df22-1019-4b88-be3b-a2732b215e07-1665327871d606a5fd-0",
