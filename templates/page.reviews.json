    "5b195d5b-77e5-42f3-9b3c-406e649e5ae5": {
      "type": "rich-text",
      "blocks": {
        "template--16629528068339__5b195d5b-77e5-42f3-9b3c-406e649e5ae5-1665327871d606a5fd-1": {
          "type": "text",
          "settings": {
            "text": "<p>I sleep a lot faster using it every night thanks to the sleep mask. I felt the drowsiness on my eyes while wearing the mask because the two circles are soft and comforting. <strong>[Kevin, Facebook]</strong></p>"
          }
        }
      },
      "block_order": [
        "template--16629528068339__5b195d5b-77e5-42f3-9b3c-406e649e5ae5-1665327871d606a5fd-1"
