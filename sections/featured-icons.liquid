{% comment %}
  Feature Badges Section
  Displays 5 feature badges with icons and descriptions
  Responsive for mobile and desktop
{% endcomment %}

<section class="feature-badges-section page-width">
  <div class="feature-badges-wrapper">
    <div class="feature-badges-container">
      
      {% comment %} Badge 1: Free Shipping {% endcomment %}
      <div class="feature-badge">
        <div class="feature-badge__icon">
          {% if section.settings.badge_1_image != blank %}
            <img 
              src="{{ section.settings.badge_1_image | img_url: 'master' }}" 
              alt="{{ section.settings.badge_1_title }}"
              loading="lazy"
              width="80"
              height="80"
            >
          {% else %}
            <img 
              src="https://placeholdit.com/80x80/dddddd/999999?text=icon" 
              alt="Placeholder"
              width="80"
              height="80"
            >
          {% endif %}
        </div>
        <h3 class="feature-badge__title">{{ section.settings.badge_1_title }}</h3>
        <p class="feature-badge__description">{{ section.settings.badge_1_description }}</p>
      </div>

      {% comment %} Badge 2: Average Rating {% endcomment %}
