      <div class="feature-badge">
        <div class="feature-badge__icon">
          {% if section.settings.badge_4_image != blank %}
            <img 
              src="{{ section.settings.badge_4_image | img_url: 'master' }}" 
              alt="{{ section.settings.badge_4_title }}"
              loading="lazy"
              width="80"
              height="80"
            >
          {% else %}
            <img 
              src="https://placeholdit.com/80x80/dddddd/999999?text=icon" 
              alt="Placeholder"
              width="80"
