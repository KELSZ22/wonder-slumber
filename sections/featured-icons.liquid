        </div>
        <h3 class="feature-badge__title">{{ section.settings.badge_2_title }}</h3>
        <p class="feature-badge__description">{{ section.settings.badge_2_description }}</p>
      </div>

      {% comment %} Badge 3: Cash on Delivery {% endcomment %}
      <div class="feature-badge">
        <div class="feature-badge__icon">
          {% if section.settings.badge_3_image != blank %}
            <img 
              src="{{ section.settings.badge_3_image | img_url: 'master' }}" 
              alt="{{ section.settings.badge_3_title }}"
              loading="lazy"
              width="80"
              height="80"
            >
          {% else %}
            <img 
              src="https://placeholdit.com/80x80/dddddd/999999?text=icon" 
              alt="Placeholder"
