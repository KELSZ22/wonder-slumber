{% schema %}
{
  "name": "Media Feature",
  "tag": "section",
  "class": "media-feature-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As Seen On"
    }
  ],
  "blocks": [
    {
      "type": "media_logo",
      "name": "Logo + Link",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Media Feature"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.media-feature {
  text-align: center;
  padding: 10px 20px 30px;
}

.media-feature__title {
  text-transform: uppercase;
  font-size: 14px;
  letter-spacing: 2px;
  margin-bottom: 30px;
}

.media-feature__logos {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40px;
  flex-wrap: wrap;
}

.media-feature__logo {
  height: 60px;
  object-fit: contain;
  transition: opacity 0.3s ease;
}

.media-feature__logo:hover {
  opacity: 0.8;
}
{% endstylesheet %}

<div class="media-feature">
  {% if section.settings.heading != blank %}
    <p class="media-feature__title">{{ section.settings.heading }}</p>
  {% endif %}

  <div class="media-feature__logos">
    {% for block in section.blocks %}
      {% if block.settings.logo != blank %}
        <a href="{{ block.settings.link | default: '#' }}" target="_blank" rel="noopener noreferrer">
          <img src="{{ block.settings.logo | image_url: width: 200 }}" alt="Logo" class="media-feature__logo">
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>