{% liquid
  assign testimonial_images = product.metafields.custom.product_image_testimonial.value
%}

{% if testimonial_images != blank %}
  <section class="product-image-testimonial section-{{ section.id }}-padding">
    <div class="page-width">
      {% if section.settings.heading != blank %}
        <div class="product-image-testimonial__header">
          <h2 class="product-image-testimonial__heading product-image-testimonial__heading--{{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        </div>
      {% endif %}

      <div class="product-image-testimonial__outer {% if section.settings.enable_swipe_on_mobile %}product-image-testimonial__outer--swipe{% endif %}">
        <div class="product-image-testimonial__grid product-image-testimonial__grid--align-{{ section.settings.column_alignment }} product-image-testimonial__grid--image-width-{{ section.settings.image_width }}">
          {% for image in testimonial_images %}
            {% if image != blank %}
              <div class="product-image-testimonial__item">
                <div class="product-image-testimonial__card product-image-testimonial__card--{{ section.settings.secondary_background }}">
                  <div class="product-image-testimonial__media-wrap">
                    <div class="product-image-testimonial__media product-image-testimonial__media--{{ section.settings.image_ratio }}">
                      {{
                        image
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '320, 480, 640, 800, 1000, 1200',
                          class: 'product-image-testimonial__image',
                          alt: image.alt
                      }}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <style>
      .section-{{ section.id }}-padding {
        --desktop-columns: {{ section.settings.columns_desktop }};
        --mobile-columns: {{ section.settings.columns_mobile }};
        --mobile-gap: 16px;
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top_desktop }}px;
          padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
        }
      }
      .product-image-testimonial {
        background-color: #e7f0f4;
      }
      .product-image-testimonial__header {
        text-align: center;
        margin-bottom: 3.2rem;
      }

      .product-image-testimonial__heading {
        margin: 0;
        line-height: 1.1;
      }

      .product-image-testimonial__heading--small {
        font-size: 2.8rem;
      }

      .product-image-testimonial__heading--medium {
        font-size: 3.8rem;
      }

      .product-image-testimonial__heading--large {
        font-size: 4.8rem;
      }

      .product-image-testimonial__grid {
        display: grid;
        grid-template-columns: repeat(var(--mobile-columns), minmax(0, 1fr));
        gap: 1.6rem;
      }

      @media screen and (min-width: 750px) {
        .product-image-testimonial__grid {
          grid-template-columns: repeat(var(--desktop-columns), minmax(0, 1fr));
          gap: 2.4rem;
        }
      }

      .product-image-testimonial__card {
        height: 100%;
      }

      .product-image-testimonial__card--none {
        background: transparent;
        padding: 0;
        border-radius: 0;
      }

      .product-image-testimonial__card--subtle {
        background: #f5f7f8;
        padding: 1.2rem;
        border-radius: 1.6rem;
      }

      .product-image-testimonial__card--contrast {
        background: #dfe8ed;
        padding: 1.2rem;
        border-radius: 1.6rem;
      }

      .product-image-testimonial__grid--align-left .product-image-testimonial__card {
        text-align: left;
      }

      .product-image-testimonial__grid--align-center .product-image-testimonial__card {
        text-align: center;
      }

      .product-image-testimonial__media-wrap {
        display: inline-block;
        width: 100%;
      }

      .product-image-testimonial__grid--image-width-full .product-image-testimonial__media-wrap {
        width: 100%;
      }

      .product-image-testimonial__grid--image-width-half .product-image-testimonial__media-wrap {
        width: 50%;
      }

      .product-image-testimonial__grid--image-width-third .product-image-testimonial__media-wrap {
        width: 33.333%;
      }

      .product-image-testimonial__media {
        width: 100%;
        overflow: hidden;
      }

      .product-image-testimonial__media--adapt {
        aspect-ratio: auto;
      }

      .product-image-testimonial__media--square {
        aspect-ratio: 1 / 1;
      }

      .product-image-testimonial__media--portrait {
        aspect-ratio: 3 / 4;
      }

      .product-image-testimonial__image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .product-image-testimonial__media--adapt .product-image-testimonial__image {
        height: auto;
      }

      @media screen and (max-width: 749px) {
        .product-image-testimonial__heading--small {
          font-size: 2.2rem;
        }

        .product-image-testimonial__heading--medium {
          font-size: 2.8rem;
        }

        .product-image-testimonial__heading--large {
          font-size: 3.4rem;
        }

        .product-image-testimonial__outer--swipe {
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          scroll-snap-type: x mandatory;
        }

        .product-image-testimonial__outer--swipe .product-image-testimonial__grid {
          display: flex;
          gap: var(--mobile-gap);
        }

        .product-image-testimonial__outer--swipe .product-image-testimonial__item {
          flex: 0 0 calc((100% - (var(--mobile-gap) * (var(--mobile-columns) - 1))) / var(--mobile-columns));
          scroll-snap-align: start;
        }
      }
    </style>
  </section>
{% endif %}

{% schema %}
{
  "name": "Product Image Testimonial",
  "tag": "section",
  "class": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Happy Customers"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "small",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Image width",
      "default": "full",
      "options": [
        {
          "value": "third",
          "label": "One-third width of column"
        },
        {
          "value": "half",
          "label": "Half width of column"
        },
        {
          "value": "full",
          "label": "Full width of column"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "adapt",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Number of columns on desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "column_alignment",
      "label": "Column alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "secondary_background",
      "label": "Secondary background",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "contrast",
          "label": "Contrast"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Number of columns on mobile",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_swipe_on_mobile",
      "label": "Enable swipe on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Product Image Testimonial"
    }
  ]
}
{% endschema %}