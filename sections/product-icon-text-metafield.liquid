{% liquid
  assign icon_group = product.metafields.custom.product_icon_group.value
  assign has_icon_items = false

  if icon_group != blank and icon_group.items.value != blank
    for item in icon_group.items.value
      assign item_text = item.text.value
      if item.icon.value != blank or item_text != blank
        assign has_icon_items = true
        break
      endif
    endfor
  endif
%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .product-icon-row__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }

  .product-icon-row__item {
    flex: 0 1 calc((100% -(2.4rem * 4)) / 5);
    max-width: calc((100% -(2.4rem * 4)) / 5);
    min-width: 0;
    text-align: center;
  }

  .product-icon-row__image-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 1.2rem;
  }

  .product-icon-row__image {
    display: block;
    max-width: 90px;
    width: 100%;
    height: auto;
  }

 .product-icon-row__text {
    margin: 0;
    font-size: 11px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #000000;
  }

  @media screen and (max-width: 989px) {
    .product-icon-row__item {
      flex-basis: calc((100% -(2.4rem * 2)) / 3);
      max-width: calc((100% -(2.4rem * 2)) / 3);
    }
  }

  @media screen and (max-width: 749px) {
    .product-icon-row__grid {
      gap: 2rem 1.6rem;
    }

    .product-icon-row__item {
      flex-basis: calc((100% - 1.6rem) / 2);
      max-width: calc((100% - 1.6rem) / 2);
    }

    .product-icon-row__image {
      max-width: 72px;
    }

    .product-icon-row__text {
      font-size: 1.2rem;
    }
  }
{%- endstyle -%}

{% if icon_group != blank and has_icon_items %}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="section-{{ section.id }}-padding">
      <div class="page-width">
        <div class="product-icon-row">
          <div class="product-icon-row__grid">
            {% for item in icon_group.items.value %}
              {% liquid
                assign item_icon = item.icon.value
                assign item_text = item.text.value
              %}

              {% if item_icon != blank or item_text != blank %}
                <div class="product-icon-row__item">
                  {% if item_icon != blank %}
                    <div class="product-icon-row__image-wrap">
                      <img
                        class="product-icon-row__image"
                        src="{{ item_icon | image_url: width: 200 }}"
                        alt="{{ item_text | escape }}"
                        loading="lazy"
                        width="{{ item_icon.width }}"
                        height="{{ item_icon.height }}">
                    </div>
                  {% endif %}

                  {% if item_text != blank %}
                    <p class="product-icon-row__text">
                      {{ item_text }}
                    </p>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
  {
    "name": "Product icon metaobject",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "select",
        "id": "color_scheme",
        "options": [
          {
            "value": "accent-1",
            "label": "t:sections.all.colors.accent_1.label"
          },
          {
            "value": "accent-2",
            "label": "t:sections.all.colors.accent_2.label"
          },
          {
            "value": "background-1",
            "label": "t:sections.all.colors.background_1.label"
          },
          {
            "value": "background-2",
            "label": "t:sections.all.colors.background_2.label"
          }, {
            "value": "inverse",
            "label": "t:sections.all.colors.inverse.label"
          }
        ],
        "default": "background-1",
        "label": "t:sections.all.colors.label"
      }, {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 40
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 52
      }
    ],
    "presets": [
      {
        "name": "Product icon metaobject"
      }
    ]
  }
{% endschema %}