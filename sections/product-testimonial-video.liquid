{% assign testimonial_group = product.metafields.custom.product_testimonial_group.value %}
{% assign has_valid_testimonials = false %}

{% if testimonial_group and testimonial_group.items.value %}
  {% for item in testimonial_group.items.value %}
    {% assign raw_url = item.youtube_url.value | default: item.youtube_url %}
    {% if raw_url != blank %}
      {% assign has_valid_testimonials = true %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .testimonial-video-slider__heading {
    text-align: center;
    margin: 0 0 3rem;
  }

  .testimonial-video-slider {
    position: relative;
  }

  .testimonial-video-slider__track-wrap {
    overflow: hidden;
  }

  .testimonial-video-slider__track {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
  }

  .testimonial-video-slider__track::-webkit-scrollbar {
    display: none;
  }

  .testimonial-video-card {
    position: relative;
    flex: 0 0 calc(25% - 1.5rem);
    min-width: 260px;
    scroll-snap-align: start;
  }

  .testimonial-video-card__frame {
    position: relative;
    border: 1px solid rgba(0,0,0,.12);
    background: #000;
    overflow: hidden;
    aspect-ratio: 9 / 16;
  }

  .testimonial-video-card__media {
    position: absolute;
    inset: 0;
  }

  .testimonial-video-card__media iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .testimonial-video-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0,0,0,.45) 0%, rgba(0,0,0,.08) 28%, rgba(0,0,0,0) 48%);
  }

  .testimonial-video-card__top {
    position: absolute;
    top: 1.6rem;
    left: 1.6rem;
    right: 1.6rem;
    z-index: 3;
    color: #fff;
    pointer-events: none;
  }

  .testimonial-video-card__title {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.2;
    font-weight: 700;
    color: #fff;
  }

  .testimonial-video-card__subtitle {
    margin: .2rem 0 0;
    font-size: 1.2rem;
    line-height: 1.2;
    color: #fff;
  }

  .testimonial-video-card__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;
    transform: translate(-50%, -50%);
    width: 7.8rem;
    height: 5.6rem;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    pointer-events: auto;
  }

  .testimonial-video-card__play::before,
  .testimonial-video-card__play::after {
    content: '';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: #ff0033;
    border-radius: 999px;
  }

  .testimonial-video-card__play::before {
    left: 0;
    width: 4.4rem;
    height: 3.6rem;
    transform: translateY(-50%) rotate(-35deg);
  }

  .testimonial-video-card__play::after {
    right: 0;
    width: 4.4rem;
    height: 3.6rem;
    transform: translateY(-50%) rotate(35deg);
  }

  .testimonial-video-card__play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    transform: translate(-38%, -50%);
    width: 0;
    height: 0;
    border-top: 1rem solid transparent;
    border-bottom: 1rem solid transparent;
    border-left: 1.6rem solid #fff;
  }

  .testimonial-video-card__share-row {
    display: flex;
    justify-content: flex-start;
    margin-top: 1rem;
    position: relative;
  }

  .testimonial-video-card__share-button {
    width: 4.4rem;
    height: 4.4rem;
    border: 0;
    border-radius: 50%;
    background: rgba(0,0,0,.45);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #fff;
  }

  .testimonial-video-card__share-button svg {
    width: 2rem;
    height: 2rem;
    display: block;
  }

  .testimonial-video-card__share-modal {
    position: absolute;
    top: -1.2rem;
    left: calc(100% + 1.2rem);
    width: 26rem;
    background: #fff;
    border-radius: 1.6rem;
    box-shadow: 0 10px 40px rgba(0,0,0,.18);
    padding: 1.6rem 1.2rem;
    z-index: 20;
    display: none;
  }

  .testimonial-video-card__share-modal.is-open {
    display: block;
  }

  .testimonial-video-card__share-handle {
    width: 4rem;
    height: .4rem;
    background: rgba(0,0,0,.15);
    border-radius: 999px;
    margin: 0 auto 1.6rem;
  }

  .testimonial-video-card__share-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 1.2rem;
  }

  .testimonial-video-card__share-input {
    width: 100%;
    border: 0;
    background: #f2f4f7;
    border-radius: .8rem;
    padding: 1rem;
    font-size: 1.2rem;
    margin-bottom: 1.2rem;
  }

  .testimonial-video-card__share-list {
    display: grid;
    gap: .8rem;
  }

  .testimonial-video-card__share-link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: .8rem 0;
  }

  .testimonial-video-slider__controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.6rem;
    margin-top: 2rem;
  }

  .testimonial-video-slider__arrow {
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 2rem;
    line-height: 1;
    padding: 0;
  }

  .testimonial-video-slider__dots {
    display: flex;
    gap: .8rem;
    align-items: center;
  }

  .testimonial-video-slider__dot {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: rgba(0,0,0,.18);
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .testimonial-video-slider__dot.is-active {
    background: rgba(0,0,0,.45);
  }

  @media screen and (max-width: 989px) {
    .testimonial-video-card {
      flex: 0 0 calc(50% - 1rem);
      min-width: 240px;
    }

    .testimonial-video-card__share-modal {
      left: auto;
      right: 0;
      top: calc(100% + 1rem);
      width: 24rem;
    }
  }

  @media screen and (max-width: 749px) {
    .testimonial-video-card {
      flex: 0 0 85%;
      min-width: 85%;
    }

    .testimonial-video-card__share-modal {
      right: 0;
      left: auto;
      width: min(24rem, calc(100vw - 4rem));
    }
  }
{%- endstyle -%}

{% if testimonial_group and has_valid_testimonials %}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="section-{{ section.id }}-padding">
      <div class="page-width">
        <div class="testimonial-video-slider" id="TestimonialVideoSlider-{{ section.id }}">
          {% if testimonial_group.heading != blank %}
            <h2 class="testimonial-video-slider__heading {{ section.settings.heading_size }}">
              {{ testimonial_group.heading | escape }}
            </h2>
          {% endif %}

          <div class="testimonial-video-slider__track-wrap">
            <div class="testimonial-video-slider__track" data-track>
              {% for item in testimonial_group.items.value %}
                {% assign raw_url = item.youtube_url.value | default: item.youtube_url %}
                {% if raw_url != blank %}
                  {% assign youtube_id = '' %}

                  {% if raw_url contains 'youtu.be/' %}
                    {% assign youtube_id = raw_url | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first %}
                  {% elsif raw_url contains 'watch?v=' %}
                    {% assign youtube_id = raw_url | split: 'watch?v=' | last | split: '&' | first %}
                  {% elsif raw_url contains '/embed/' %}
                    {% assign youtube_id = raw_url | split: '/embed/' | last | split: '?' | first | split: '&' | first %}
                  {% endif %}

                  {% if youtube_id != blank %}
                    <div class="testimonial-video-card" data-index="{{ forloop.index0 }}">
                      <div class="testimonial-video-card__frame">
                        <div class="testimonial-video-card__media">
                          <iframe
                            class="testimonial-video-card__iframe"
                            data-src="https://www.youtube.com/embed/{{ youtube_id }}?enablejsapi=1&playsinline=1&rel=0"
                            title="{{ item.title | default: testimonial_group.heading | escape }}"
                            loading="lazy"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen
                          ></iframe>
                        </div>

                        <div class="testimonial-video-card__overlay"></div>

                        <div class="testimonial-video-card__top">
                          {% if item.title != blank %}
                            <p class="testimonial-video-card__title">{{ item.title }}</p>
                          {% endif %}
                          {% if item.subtitle != blank %}
                            <p class="testimonial-video-card__subtitle">{{ item.subtitle }}</p>
                          {% endif %}
                        </div>

                        <button type="button" class="testimonial-video-card__play" aria-label="Play video">
                          <span class="testimonial-video-card__play-icon"></span>
                        </button>
                      </div>

                      <div class="testimonial-video-card__share-row">
                        <button type="button" class="testimonial-video-card__share-button" aria-label="Share video">
                          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path fill="currentColor" d="M18 16a3 3 0 0 0-2.39 1.19l-6.94-3.47a3.12 3.12 0 0 0 0-1.44l6.94-3.47A3 3 0 1 0 15 7a3.12 3.12 0 0 0 .06.56L8.12 11.03a3 3 0 1 0 0 1.94l6.94 3.47A3.12 3.12 0 0 0 15 17a3 3 0 1 0 3-1z"></path>
                          </svg>
                        </button>

                        <div class="testimonial-video-card__share-modal" hidden>
                          <div class="testimonial-video-card__share-handle"></div>
                          <p class="testimonial-video-card__share-title">Share</p>
                          <input
                            class="testimonial-video-card__share-input"
                            type="text"
                            value="https://youtu.be/{{ youtube_id }}"
                            readonly
                          >
                          <div class="testimonial-video-card__share-list">
                            <a class="testimonial-video-card__share-link" href="https://wa.me/?text=https://youtu.be/{{ youtube_id }}" target="_blank" rel="noopener">WhatsApp</a>
                            <a class="testimonial-video-card__share-link" href="https://www.facebook.com/sharer/sharer.php?u=https://youtu.be/{{ youtube_id }}" target="_blank" rel="noopener">Facebook</a>
                            <a class="testimonial-video-card__share-link" href="https://twitter.com/intent/tweet?url=https://youtu.be/{{ youtube_id }}" target="_blank" rel="noopener">X</a>
                            <a class="testimonial-video-card__share-link" href="mailto:?subject=Check this video&body=https://youtu.be/{{ youtube_id }}">Email</a>
                          </div>
                        </div>
                      </div>
                    </div>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <div class="testimonial-video-slider__controls">
            <button type="button" class="testimonial-video-slider__arrow" data-prev aria-label="Previous testimonials">&lt;</button>
            <button type="button" class="testimonial-video-slider__arrow" data-next aria-label="Next testimonials">&gt;</button>
          </div>

          <div class="testimonial-video-slider__dots" data-dots></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function() {
      const slider = document.getElementById('TestimonialVideoSlider-{{ section.id }}');
      if (!slider) return;

      const track = slider.querySelector('[data-track]');
      const prevBtn = slider.querySelector('[data-prev]');
      const nextBtn = slider.querySelector('[data-next]');
      const dotsWrap = slider.querySelector('[data-dots]');
      const cards = Array.from(track.querySelectorAll('.testimonial-video-card'));

      if (!cards.length) return;

      cards.forEach((card, index) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'testimonial-video-slider__dot' + (index === 0 ? ' is-active' : '');
        dot.setAttribute('aria-label', 'Go to testimonial ' + (index + 1));
        dot.addEventListener('click', () => {
          cards[index].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        });
        dotsWrap.appendChild(dot);
      });

      const dots = Array.from(dotsWrap.querySelectorAll('.testimonial-video-slider__dot'));

      function updateDots() {
        const trackLeft = track.getBoundingClientRect().left;
        let activeIndex = 0;
        let smallest = Infinity;

        cards.forEach((card, index) => {
          const diff = Math.abs(card.getBoundingClientRect().left - trackLeft);
          if (diff < smallest) {
            smallest = diff;
            activeIndex = index;
          }
        });

        dots.forEach((dot, index) => {
          dot.classList.toggle('is-active', index === activeIndex);
        });
      }

      function getStep() {
        if (cards.length < 2) return cards[0].offsetWidth;
        return cards[1].offsetLeft - cards[0].offsetLeft;
      }

      prevBtn.addEventListener('click', () => {
        const step = getStep();
        const maxScroll = track.scrollWidth - track.clientWidth;
        if (track.scrollLeft <= 5) {
          track.scrollTo({ left: maxScroll, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: -step, behavior: 'smooth' });
        }
      });

      nextBtn.addEventListener('click', () => {
        const step = getStep();
        const maxScroll = track.scrollWidth - track.clientWidth;
        if (track.scrollLeft >= maxScroll - 5) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: step, behavior: 'smooth' });
        }
      });

      track.addEventListener('scroll', () => {
        window.requestAnimationFrame(updateDots);
      });

      updateDots();

      const allShareButtons = slider.querySelectorAll('.testimonial-video-card__share-button');

      allShareButtons.forEach((button) => {
        button.addEventListener('click', function(e) {
          e.stopPropagation();

          const card = button.closest('.testimonial-video-card');
          const modal = card.querySelector('.testimonial-video-card__share-modal');
          const isOpen = modal.classList.contains('is-open');

          slider.querySelectorAll('.testimonial-video-card__share-modal').forEach((m) => {
            m.classList.remove('is-open');
            m.setAttribute('hidden', '');
          });

          if (!isOpen) {
            modal.classList.add('is-open');
            modal.removeAttribute('hidden');
          }
        });
      });

      document.addEventListener('click', function(e) {
        if (!slider.contains(e.target)) {
          slider.querySelectorAll('.testimonial-video-card__share-modal').forEach((m) => {
            m.classList.remove('is-open');
            m.setAttribute('hidden', '');
          });
        }
      });

      const playButtons = slider.querySelectorAll('.testimonial-video-card__play');

      playButtons.forEach((button) => {
        button.addEventListener('click', function() {
          const card = button.closest('.testimonial-video-card');
          const iframe = card.querySelector('.testimonial-video-card__iframe');
          const currentSrc = iframe.getAttribute('src');
          const lazySrc = iframe.getAttribute('data-src');

          if (!currentSrc) {
            iframe.setAttribute('src', lazySrc + '&autoplay=1');
          } else if (currentSrc.indexOf('autoplay=1') === -1) {
            iframe.setAttribute('src', currentSrc + '&autoplay=1');
          }

          button.style.display = 'none';
          const overlay = card.querySelector('.testimonial-video-card__overlay');
          if (overlay) overlay.style.display = 'none';
        });
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Product testimonial vid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "t:sections.all.colors.accent_1.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.all.colors.accent_2.label"
        },
        {
          "value": "background-1",
          "label": "t:sections.all.colors.background_1.label"
        },
        {
          "value": "background-2",
          "label": "t:sections.all.colors.background_2.label"
        },
        {
          "value": "inverse",
          "label": "t:sections.all.colors.inverse.label"
        }
      ],
      "default": "background-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h0",
      "label": "Heading size"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Product testimonial vid"
    }
  ]
}
{% endschema %}