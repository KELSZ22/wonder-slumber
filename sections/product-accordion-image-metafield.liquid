{% render 'hs-defer-css' with filename: 'component-accordion.css', pages: 'collection,index,product' | split: ',', local: true %}
{% render 'hs-defer-css' with filename: 'collapsible-content.css', pages: 'collection,index,product' | split: ',', local: true %}

{% assign accordion_group = product.metafields.custom.ingredient_accordion_group.value %}
{% assign has_valid_items = false %}

{% if accordion_group and accordion_group.items.value %}
  {% for item in accordion_group.items.value %}
    {% if item.title != blank or item.content != blank %}
      {% assign has_valid_items = true %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .ingredient-accordion-section--{{ section.id }} {
    background: {{ section.settings.section_bg_color }};
  }

  .ingredient-accordion-shell--{{ section.id }} {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .ingredient-accordion-shell--{{ section.id }} {
      padding-left: 5rem;
      padding-right: 5rem;
    }
  }

  .ingredient-accordion-inner--{{ section.id }} {
    background: {{ section.settings.inner_container_bg_color }};
    border-radius: {{ section.settings.container_radius }}px;
    overflow: hidden;
  }

  .ingredient-accordion-content--{{ section.id }} {
    padding-left: 2rem;
    padding-right: 2rem;
  }

  @media screen and (min-width: 750px) {
    .ingredient-accordion-content--{{ section.id }} {
      padding-left: 5rem;
      padding-right: 5rem;
    }
  }

  .ingredient-accordion-section--{{ section.id }} .collapsible-content__heading,
  .ingredient-accordion-section--{{ section.id }} .accordion__title,
  .ingredient-accordion-section--{{ section.id }} summary,
  .ingredient-accordion-section--{{ section.id }} summary svg {
    color: {{ section.settings.heading_color }};
  }

  .ingredient-accordion-section--{{ section.id }} .accordion__content,
  .ingredient-accordion-section--{{ section.id }} .accordion__content p,
  .ingredient-accordion-section--{{ section.id }} .accordion__content li,
  .ingredient-accordion-section--{{ section.id }} .caption-with-letter-spacing {
    color: {{ section.settings.text_color }};
  }

  .ingredient-accordion-section--{{ section.id }} .accordion,
  .ingredient-accordion-section--{{ section.id }} details,
  .ingredient-accordion-section--{{ section.id }} summary,
  .ingredient-accordion-section--{{ section.id }} .collapsible-content__media,
  .ingredient-accordion-section--{{ section.id }} .media {
    background: transparent;
  }

  .ingredient-accordion-section--{{ section.id }} .accordion {
    margin-top: 0;
  }

  .ingredient-accordion-section--{{ section.id }} .accordion details {
    border-bottom: 1px solid {{ section.settings.border_color }};
  }

  .ingredient-accordion-section--{{ section.id }} .accordion:first-child details {
    border-top: 1px solid {{ section.settings.border_color }};
  }

  .ingredient-accordion-section--{{ section.id }} .icon-caret {
    color: {{ section.settings.heading_color }};
  }

  .ingredient-accordion-section--{{ section.id }} .collapsible-content__media {
    border-radius: 0;
    overflow: visible;
  }

  .ingredient-accordion-section--{{ section.id }} .collapsible-content__media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .ingredient-accordion-section--{{ section.id }} .collapsible-content__header {
    margin-bottom: 3rem;
  }
{%- endstyle -%}

{% if accordion_group and has_valid_items %}
  <div class="ingredient-accordion-section ingredient-accordion-section--{{ section.id }}">
    <div class="ingredient-accordion-shell ingredient-accordion-shell--{{ section.id }} section-{{ section.id }}-padding">
      <div class="ingredient-accordion-inner ingredient-accordion-inner--{{ section.id }}">
        <div class="ingredient-accordion-content ingredient-accordion-content--{{ section.id }}">
          <div class="collapsible-content">
            <div class="collapsible-content__header" style="text-align: {{ section.settings.heading_alignment }};">
              {%- if section.settings.caption != blank -%}
                <p class="caption-with-letter-spacing">{{ section.settings.caption | escape }}</p>
              {% endif %}

              {%- if accordion_group.heading != blank -%}
                <h2 class="collapsible-content__heading {{ section.settings.heading_size }}">
                  {{ accordion_group.heading | escape }}
                </h2>
              {%- else -%}
                <h2 class="visually-hidden">{{ 'accessibility.collapsible_content_title' | t }}</h2>
              {% endif %}
            </div>

            <div class="grid grid--1-col grid--2-col-tablet collapsible-content__grid{% if section.settings.desktop_layout == 'image_second' %} collapsible-content__grid--reverse{% endif %}">
              {%- if accordion_group.image.value != blank -%}
                <div class="grid__item collapsible-content__grid-item">
                  <div
                    class="collapsible-content__media collapsible-content__media--{{ section.settings.image_ratio }} media global-media-settings"
                    {% if section.settings.image_ratio == 'adapt' %}
                      style="padding-bottom: {{ 1 | divided_by: accordion_group.image.value.aspect_ratio | times: 100 }}%;"
                    {% endif %}
                  >
                    {%- capture sizes -%}(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 160 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 160px) / 2), calc(100vw - 4rem){%- endcapture -%}
                    {{
                      accordion_group.image.value
                      | image_url: width: 1500
                      | image_tag:
                        loading: 'lazy',
                        sizes: sizes,
                        widths: '165, 360, 535, 750, 1070, 1250, 1500'
                    }}
                  </div>
                </div>
              {% endif %}

              <div class="grid__item">
                {% for item in accordion_group.items.value %}
                  {% if item.title != blank or item.content != blank %}
                    <div class="accordion">
                      <details id="Details-{{ forloop.index }}-{{ section.id }}"{% if section.settings.open_first_collapsible_row and forloop.first %} open{% endif %}>
                        <summary id="Summary-{{ forloop.index }}-{{ section.id }}">
                          <h3 class="accordion__title h4">
                            {{ item.title }}
                          </h3>
                          {% render 'icon-caret' %}
                        </summary>
                        <div
                          class="accordion__content rte"
                          id="CollapsibleAccordion-{{ forloop.index }}-{{ section.id }}"
                          role="region"
                          aria-labelledby="Summary-{{ forloop.index }}-{{ section.id }}"
                        >
                          {{ item.content | metafield_tag }}
                        </div>
                      </details>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Ingredient accordions",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background color",
      "default": "#e8edf2"
    },
    {
      "type": "color",
      "id": "inner_container_bg_color",
      "label": "Inner container background color",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1f2328"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#5f6368"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider color",
      "default": "#d8dadd"
    },
    {
      "type": "range",
      "id": "container_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Container border radius",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "open_first_collapsible_row",
      "default": false,
      "label": "Open first accordion by default"
    },
    {
      "type": "header",
      "content": "Image settings"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "image_second",
          "label": "Image second"
        }
      ],
      "default": "image_second",
      "label": "Desktop layout"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Ingredient accordions"
    }
  ]
}
{% endschema %}