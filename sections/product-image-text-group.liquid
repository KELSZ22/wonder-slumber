{% liquid
  assign content_group = product.metafields.custom.product_image_text_group.value
  assign item_count = 0
  assign single_image_only = false

  if content_group != blank
    assign section_heading = content_group.heading.value
    assign section_background = content_group.background_color.value | default: '#edf3f6'
    assign text_background = content_group.text_column_background.value | default: '#ffffff'
    assign group_items = content_group.items.value

    if group_items != blank
      assign item_count = group_items.size
      assign first_item = group_items.first

      if item_count == 1 and first_item != blank and first_item.image.value != blank and first_item.text_heading.value == blank and first_item.text_description == blank
        assign single_image_only = true
      endif
    endif
  endif
%}

{% if content_group != blank and group_items != blank %}
  <section
    class="product-image-text-group section-{{ section.id }}-padding"
    style="background: {{ section_background }};"
  >
    <div class="page-width">
      {% if section_heading != blank %}
        <div class="product-image-text-group__header">
          <h2 class="product-image-text-group__heading">
            {{ section_heading }}
          </h2>
        </div>
      {% endif %}

      {% if single_image_only %}
        {% assign single_image = first_item.image.value %}
        <div class="product-image-text-group__single-image">
          {{
            single_image
            | image_url: width: 2400
            | image_tag:
              loading: 'lazy',
              widths: '750, 1100, 1500, 2000, 2400',
              class: 'product-image-text-group__single-image-img',
              alt: single_image.alt
          }}
        </div>
      {% else %}
        <div class="product-image-text-group__rows">
          {% for item in group_items %}
            {% liquid
              assign item_image = item.image.value
              assign item_heading = item.text_heading.value
              assign has_text = false
              assign remainder = forloop.index0 | modulo: 2
              assign reverse_row = false

              if remainder == 1
                assign reverse_row = true
              endif

              if item_heading != blank or item.text_description != blank
                assign has_text = true
              endif
            %}

            {% if item_image != blank %}
              {% if has_text %}
                <div class="product-image-text-group__row {% if reverse_row %}product-image-text-group__row--reverse{% endif %}">
                  <div class="product-image-text-group__media">
                    {{
                      item_image
                      | image_url: width: 1800
                      | image_tag:
                        loading: 'lazy',
                        widths: '550, 750, 900, 1200, 1500, 1800',
                        class: 'product-image-text-group__image',
                        alt: item_image.alt
                    }}
                  </div>

                  <div
                    class="product-image-text-group__text"
                    style="background: {{ text_background }};"
                  >
                    {% if item_heading != blank %}
                      <h3 class="product-image-text-group__text-heading">
                        {{ item_heading }}
                      </h3>
                    {% endif %}

                    {% if item.text_description != blank %}
                      <div class="product-image-text-group__text-description rte">
                        {{ item.text_description | metafield_tag }}
                      </div>
                    {% endif %}
                  </div>
                </div>
              {% else %}
                <div class="product-image-text-group__single-row-image">
                  {{
                    item_image
                    | image_url: width: 2400
                    | image_tag:
                      loading: 'lazy',
                      widths: '750, 1100, 1500, 2000, 2400',
                      class: 'product-image-text-group__single-image-img',
                      alt: item_image.alt
                  }}
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <style>
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top_desktop }}px;
          padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
        }
      }

      .product-image-text-group__header {
        text-align: center;
        margin-bottom: 3.2rem;
      }

      .product-image-text-group__heading {
        margin: 0;
        font-size: 3.2rem;
        line-height: 1.15;
      }

      .product-image-text-group__rows {
        display: grid;
        gap: 3.2rem;
      }

      .product-image-text-group__row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: stretch;
        border-radius: 24px;
        overflow: hidden;
      }

      .product-image-text-group__row--reverse .product-image-text-group__media {
        order: 2;
      }

      .product-image-text-group__row--reverse .product-image-text-group__text {
        order: 1;
      }

      .product-image-text-group__media,
      .product-image-text-group__text {
        min-width: 0;
      }

      .product-image-text-group__media {
        height: 100%;
      }

      .product-image-text-group__image {
        display: block;
        width: 100%;
        height: 100%;
        min-height: 42rem;
        object-fit: cover;
      }

      .product-image-text-group__text {
        padding: 4rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .product-image-text-group__text-heading {
        margin: 0 0 1.6rem;
        font-size: 2.2rem;
        line-height: 1.2;
      }

      .product-image-text-group__text-description {
        font-size: 1.8rem;
        line-height: 1.7;
      }

      .product-image-text-group__text-description > *:first-child {
        margin-top: 0;
      }

      .product-image-text-group__text-description > *:last-child {
        margin-bottom: 0;
      }

      .product-image-text-group__single-image,
      .product-image-text-group__single-row-image {
        width: 100%;
      }

      .product-image-text-group__single-image-img {
        display: block;
        width: 100%;
        height: auto;
      }

      @media screen and (max-width: 749px) {
        .product-image-text-group__heading {
          font-size: 2.6rem;
        }

        .product-image-text-group__row {
          grid-template-columns: 1fr;
        }

        .product-image-text-group__media,
        .product-image-text-group__text,
        .product-image-text-group__row--reverse .product-image-text-group__media,
        .product-image-text-group__row--reverse .product-image-text-group__text {
          order: initial;
        }

        .product-image-text-group__image {
          min-height: auto;
          height: auto;
        }

        .product-image-text-group__text {
          padding: 2.4rem 2rem;
        }

        .product-image-text-group__text-heading {
          font-size: 2rem;
        }

        .product-image-text-group__text-description {
          font-size: 1.6rem;
        }
      }
    </style>
  </section>
{% endif %}

{% schema %}
{
  "name": "Product Image Text Group",
  "tag": "section",
  "class": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Product Image Text Group"
    }
  ]
}
{% endschema %}