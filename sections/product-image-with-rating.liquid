{% liquid
  assign image_rating_items = product.metafields.custom.product_image_with_rating.value
%}

{% if image_rating_items != blank %}
  <section class="product-image-with-rating section-{{ section.id }}-padding">
    {% for item in image_rating_items %}
      {% liquid
        assign item_heading = item.heading.value
        assign item_image = item.center_image.value
        assign item_rating_footer = item.rating_footer.value
        assign item_background = item.background_color.value | default: '#d8e8ee'
      %}

      <div
        class="product-image-with-rating__item"
        style="background: {{ item_background }};"
      >
        <div class="page-width product-image-with-rating__inner">
          {% if item_heading != blank %}
            <div class="product-image-with-rating__header">
              <h2 class="product-image-with-rating__heading">
                {{ item_heading | escape }}
              </h2>
            </div>
          {% endif %}

          {% if item_image != blank %}
            <div class="product-image-with-rating__image-wrap">
              {{
                item_image
                | image_url: width: 2200
                | image_tag:
                  loading: 'lazy',
                  widths: '550, 750, 900, 1100, 1500, 1800, 2200',
                  class: 'product-image-with-rating__image',
                  alt: item_heading | escape
              }}
            </div>
          {% endif %}

          {% if item_rating_footer != blank %}
            <div class="product-image-with-rating__footer">
              {{ item_rating_footer | escape }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}

    <style>
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top_desktop }}px;
          padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
        }
      }

      .product-image-with-rating {
        display: grid;
        gap: {{ section.settings.section_gap }}px;
      }

      .product-image-with-rating__item {
        width: 100%;
      }

      .product-image-with-rating__inner {
        padding-top: 2.8rem;
        padding-bottom: 2.8rem;
      }

      .product-image-with-rating__header {
        text-align: center;
        margin-bottom: 2.4rem;
      }

      .product-image-with-rating__heading {
        margin: 0;
        font-size: 3rem;
        line-height: 1.15;
        font-weight: 700;
        color: {{ section.settings.heading_color }};
      }

      .product-image-with-rating__image-wrap {
        display: flex;
        justify-content: center;
      }

      .product-image-with-rating__image {
        display: block;
        width: 100%;
        max-width: {{ section.settings.image_max_width }}px;
        height: auto;
        border-radius: {{ section.settings.image_radius }}px;
      }

      .product-image-with-rating__footer {
        text-align: center;
        margin-top: 2rem;
        font-size: 1.5rem;
        line-height: 1.5;
        color: {{ section.settings.footer_color }};
      }

      @media screen and (max-width: 749px) {
        .product-image-with-rating__inner {
          padding-top: 2rem;
          padding-bottom: 2rem;
        }

        .product-image-with-rating__heading {
          font-size: 2.2rem;
        }

        .product-image-with-rating__footer {
          font-size: 1.4rem;
          margin-top: 1.6rem;
        }
      }
    </style>
  </section>
{% elsif request.design_mode %}
  <section class="product-image-with-rating section-{{ section.id }}-padding">
    <div class="page-width">
      <div style="padding: 24px; border: 1px dashed rgba(0,0,0,.15); text-align: center;">
        Add entries to the product metafield <strong>custom.product_image_with_rating</strong>.
      </div>
    </div>

    <style>
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top_desktop }}px;
          padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
        }
      }
    </style>
  </section>
{% endif %}

{% schema %}
{
  "name": "Product Image with Rating",
  "tag": "section",
  "class": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Image max width",
      "default": 760
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Gap between items",
      "default": 32
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "footer_color",
      "label": "Footer color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Product Image with Rating"
    }
  ]
}
{% endschema %}